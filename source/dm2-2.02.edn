;; DoDAF 2.02 DM2 source extract. Data, not code. Generated once from the two official DoD files named
;; in :sources; scripts/gen-dm2.cljk derives ontology/dodaf-v2-02.mith and ontology/dodaf-v2-02-views.edn from it.
{:dm2/version "2.02"
 :sources
 {:dictionary
  {:file "DM2_Data_Dictionary_and_Mappings_v202.xls"
   :url "https://dowcio.war.gov/Portals/0/Documents/DODAF/DM2_Data_Dictionary_and_Mappings_v202.xls"
   :sha256 "7ff87dd7db559c1402987674478f1204d54586fe4025dec96fcfe0631e8aec0e"
   :sheet "Data Dic, Aliases, Mappings"
   :procedure
   ["Header rows are spreadsheet rows 1-4; data starts at row 5."
    "Keep only rows whose status (column E) is exactly \"a. In Model\" (254 rows), in sheet order."
    "Term name = column B. Definition = column C with CRLF normalized to LF and leading/trailing whitespace trimmed."
    "Association? = column I (\"Y\" or \"y\" -> true, blank -> false)."
    "DM2 Submodel (data group) = columns L-Z; the group name is the row-4 header; a cell \"x\" marks membership."
    "Model mapping = columns AC-CB; model id is the row-4 header, model title is row 2, model description is row 1; a non-blank cell is the official mapping code, kept verbatim."]
   :mapping-codes {:values ["df" "dfo" "if" "ifo" "n" "np" "o" "s"]
                   :legend nil
                   :note "The workbook publishes no legend for these codes (checked: no cell outside the mapping block uses them; the DoD CIO \"Models - Mapping to DM2\" page links only this workbook). Codes are kept verbatim and not interpreted."}}
  :model
  {:file "DM2_EA_v2.02.eap.zip"
   :url "https://dowcio.war.gov/Portals/0/Documents/DODAF/DM2_EA_v2.02.eap.zip"
   :sha256 "81617769195b6d5d5d7cda8fb3d40a8b6fdd03b14241fb9e122fddd7be480457"
   :inner-file "DM2_EA_v2.02.eap"
   :inner-sha256 "4321f814fbf47ec84103cfccc5d162301b1993f723a11cdbfa77fddfbdc6034f"
   :procedure
   ["Read the Sparx EA repository with mdbtools: mdb-export DM2_EA_v2.02.eap t_object and mdb-export DM2_EA_v2.02.eap t_connector."
    "Object names come from t_object.Name keyed by Object_ID; :ideas-kind is t_object.Stereotype of every Object_Type Class."
    "t_connector Connector_Type Generalization (stereotype IDEAS:superSubtype or superSubtype) -> :super-subtype [Start (sub) End (super)]; one connector whose ends resolve to no object is dropped."
    "t_connector Dependency stereotype IDEAS:powertypeInstance -> :powertype-instance [Start End]; stereotype typeInstance / IDEAS:typeInstance -> :type-instance [Start End]."
    "t_connector Association with stereotype place1Type / place2Type / place3Type / placeType -> :tuple-places {Start {stereotype End}}; Start is the tuple type, End the place type. The empty-string key is an unnamed EA element and is kept verbatim."]}}
 :data-groups ["Performer" "Resource Flow" "Information And Data" "Reification Levels" "Organizational Structure" "Capability" "Services" "Project" "Pedigree" "Rules" "Information Pedigree" "Measure" "Location" "IDEAS Foundation" "DM2 Foundation"]
 :models
 [{:id "AV-1" :title "AV-1 Overview and Summary Information" :description "Describes a Project's Visions, Goals, Objectives, Plans, Activities, Events, Conditions, Measures, Effects (Outcomes), and produced objects."}
  {:id "AV-2" :title "AV-2 Integrated Dictionary" :description "Architecture data repository with definitions of all terms used throughout the architecture data and presentations."}
  {:id "OV-1" :title "OV-1: High Level Operational Concept Graphic" :description "High-level graphical/textual description of operational concept"}
  {:id "OV-2" :title "OV-2: Operational Connectivity Description" :description "Operational connectivity and iresource flow needlines"}
  {:id "OV-3" :title "OV-3: Operational Resource Flow Matrix" :description "Information exchanged and the relevant attributes of that exchange"}
  {:id "OV-4" :title "OV-4: Organizational Relationships Chart" :description "Organizational, role, or other relationships among Organizations"}
  {:id "OV-5a" :title "OV-5a: Activity Decomposition Tree" :description "Activities and their decomposition hierarchy."}
  {:id "OV-5b" :title "OV-5b: Activity Model" :description "Capabilities, activities (operational activities), relationships among activities, inputs, and outputs; overlays can show cost, performers or other pertinent information"}
  {:id "OV-6a" :title "OV-6a: Operational Rules Model" :description "One of three models used to describe activity (operational activity) - identifies business rules that constrain operation"}
  {:id "OV-6b" :title "OV-6b: State Transition Description" :description "One of three models used to describe activity (operational activity) - identifies business process responses to events"}
  {:id "OV-6c" :title "OV-6c: Event-Trace Description" :description "One of three models used to describe activity (operational activity) - traces actions in a scenario or sequence of events"}
  {:id "SV-1" :title "SV-1 Systems Interface Description" :description "Identification of  systems and system items and their interconnections"}
  {:id "SV-2" :title "SV-2 Systems Communications Description" :description "Systems and system items and their related communications laydowns"}
  {:id "SV-3" :title "SV-3 Systems-Systems Matrix" :description "Relationships among systems in a given architecture; can be designed to show relationships of interest, e.g., system-type interfaces, planned vs. existing interfaces, etc."}
  {:id "SV-4" :title "SV-4 Systems Functionality Description" :description "Functions (acitivities) performed by systems and the system data flows among system functions (activities)"}
  {:id "SV-5a" :title "SV-5a Operational Activity to Systems Function Traceability Matrix" :description "Mapping of system functions (activities) back to operational activities (activities)"}
  {:id "SV-5b" :title "SV-5b Operational Activity to Systems Traceability Matrix" :description "Mapping of systems back to capabilities or operational activities (activities)"}
  {:id "SV-6" :title "SV-6 Systems Data Exchange Matrix" :description "Provides details of system data elements being exchanged between systems and the attributes of that exchange"}
  {:id "SV-7" :title "SV-7 Systems Performance Parameters Matrix" :description "Performance characteristics of Systems Model elements for the appropriate time frame(s)"}
  {:id "SV-8" :title "SV-8 Systems Evolution Description" :description "Planned incremental steps toward migrating a suite of systems to a more efficient suite, or toward evolving a current system to a future implementation."}
  {:id "SV-9" :title "SV-9 Systems Technology and Skills Forecast" :description "Emerging technologies and software/hardware products that are expected to be available in a given set of time frames and that will affect future development of the architecture"}
  {:id "SV-10a" :title "SV-10a Systems Rules Model" :description "One of three models used to describe system functionality—identifies constraints that are imposed on systems functionality due to some aspect of systems design or implementation"}
  {:id "SV-10b" :title "SV-10b Systems State Transition Description" :description "One of three models used to describe system functionality—identifies responses of a system to events"}
  {:id "SV-10c" :title "SV-10c Systems Event-Trace Description" :description "One of three models used to describe system functionality—identifies system-specific refinements of critical sequences of events described in the Operational View"}
  {:id "SvcV-1" :title "SvcV-1 Services Interface Description" :description "Identification of  services and service items and their interconnections"}
  {:id "SvcV-2" :title "SvcV-2 Services Communications Description" :description "Services and service items and their related communications laydowns"}
  {:id "SvcV-3a" :title "SvcV-3a Systems-Services Matrix" :description "Relationships among between systems and services in a given architecture."}
  {:id "SvcV-3b" :title "SvcV-3b Services-Services Matrix" :description "Relationships among services in a given architecture; can be designed to show relationships of interest, e.g., service-type interfaces, planned vs. existing interfaces, etc."}
  {:id "SvcV-4" :title "SvcV-4 Services Functionality Description" :description "Functions performed by services and the service data flows among service functions (activities)"}
  {:id "SvcV-5" :title "SvcV-5 Operational Activity to Services Traceability Matrix" :description "Mapping of services (activities)  back to operational activities (activities)"}
  {:id "SvcV-6" :title "SvcV-6 Services Data Exchange Matrix" :description "Provides details of system or service data elements being exchanged between services and the attributes of that exchange"}
  {:id "SvcV-7" :title "SvcV-7 Services Performance Parameters Matrix" :description "Performance characteristics of Services View elements for the appropriate time frame(s)"}
  {:id "SvcV-8" :title "SvcV-8 Services Evolution Description" :description "Planned incremental steps toward migrating a suite of systems to a more efficient suite, or toward evolving a current services to a future implementation."}
  {:id "SvcV-9" :title "SvcV-9 Services Technology and Skills Forecast" :description "Emerging technologies and software/hardware products that are expected to be available in a given set of time frames and that will affect future development of the architecture"}
  {:id "SvcV-10a" :title "SvcV-10a Services Rules Model" :description "One of three models used to describe service functionality - identifies constraints that are imposed on systems functionality due to some aspect of systems design or implementation"}
  {:id "SvcV-10b" :title "SvcV-10b Services State Transition Description" :description "One of three models used to describe service functionality - identifies responses of a services to events"}
  {:id "SvcV-10c" :title "SvcV-10c Services Event-Trace Description" :description "One of three models used to describe service functionality - identifies service-specific refinements of critical sequences of events described in the Operational Model"}
  {:id "StdV-1" :title "Standards View-1 Standards Profile" :description "Listing of standards that apply to solution elements in a given architecture"}
  {:id "StdV-2" :title "Standards View-2 Standards Forecast" :description "Description of emerging standards and potential impact on current  solution elements, within a set of time frames"}
  {:id "PV-1" :title "PV-1: Project Portfolio Relationships" :description "Organizational structures needed to manage a portfolio of projects and shows dependency relationships between the organizations and projects."}
  {:id "PV-2" :title "PV-2: Project Timelines" :description "A timeline perspective on programs or projects, with the key milestones and interdependencies"}
  {:id "PV-3" :title "PV-3: Project to Capability Mapping" :description "Mapping of programs and projects to capabilities to show how the specific projects and program elements help to achieve a capability"}
  {:id "CV-1" :title "CV-1: Vision" :description "Overall vision for transformational endeavors, provides a strategic context for the capabilities described, and provides a high-level scope."}
  {:id "CV-2" :title "CV-2: Capability Taxonomy" :description "A hierarchy of capabilities, specifies all the capabilities that are referenced throughout one or more architectures."}
  {:id "CV-3" :title "CV-3: Capability Phasing" :description "Planned achievement of capability at different points in time or during specific periods of time."}
  {:id "CV-4" :title "CV-4: Capability Dependencies" :description "Dependencies between planned capabilities and defines logical groupings of capabilities."}
  {:id "CV-5" :title "CV-5: Capability to Organizational Development Mapping" :description "The fulfillment of capability requirements, shows the planned capability deployment and interconnection for a particular Capability Phase."}
  {:id "CV-6" :title "CV-6: Capability to Operational Activities Mapping" :description "Mapping between the capabilities required and the operational activities that those capabilities support."}
  {:id "CV-7" :title "CV-7: Capability to Services Mapping" :description "Mapping between capabilities and the services that these capabilities enable."}
  {:id "DIV-1" :title "DIV-1:Conceptual Data Model" :description "Required High level data concepts and their relationships"}
  {:id "DIV-2" :title "DIV-2: Logical Data Model" :description "Documentation of the data requirements and structural business process rules (In DoDAF V1.5, this was the OV-7)"}
  {:id "DIV-3" :title "DIV-3: Physical Data Model" :description "Physical implementation of the Logical Data Model entities, e.g., message formats, file structures, physical schema (In DoDAF V1.5, this was the SV-11)"}]
