<https://mithril.fund/ontology/dm2/2.02> a owl:Ontology ;
    rdfs:comment "Generated from source/dm2-2.02.edn by scripts/gen_dm2_ttl.py." ;
    owl:versionInfo "2.02" .

dm2:ActivityType a owl:Class ;
    rdfs:label "ActivityType" ;
    rdfs:comment "Powertype of Activity" ;
    rdfs:subClassOf dm2:IndividualTypeType .

dm2:AdaptabilityMeasure a owl:Class ;
