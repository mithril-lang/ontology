    rdfs:label "NeedsSatisfactionMeasure" ;
    rdfs:comment "A category of quality measures that address how well a system meets the user's needs and requirements." ;
    rdfs:subClassOf dm2:ServiceLevel .

dm2:NeedsSatisfactionMeasureType a owl:Class ;
    rdfs:label "NeedsSatisfactionMeasureType" ;
    rdfs:comment "The Powertype of NeedsStatisfactionMeasure." ;
    rdfs:subClassOf dm2:ServiceLevelType .

dm2:Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:comment "A specific real-world assemblage of people and other resources organized for an on-going purpose." ;
    rdfs:subClassOf dm2:IndividualPerformer .

dm2:OrganizationType a owl:Class ;
    rdfs:label "OrganizationType" ;
    rdfs:comment "A type of Organization" ;
