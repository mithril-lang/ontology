dm2:GeoFeatureType a owl:Class ;
    rdfs:label "GeoFeatureType" ;
    rdfs:comment "Powertype Of GeoFeature" ;
    rdfs:subClassOf dm2:GeoPoliticalExtentType .

dm2:GeoFeatureTypeType a owl:Class ;
    rdfs:label "GeoFeatureTypeType" ;
    rdfs:comment "The Powertype of GeoFeatureType." ;
    rdfs:subClassOf dm2:GeoPoliticalExtentTypeType .

dm2:GeoStationaryPoint a owl:Class ;
    rdfs:label "GeoStationaryPoint" ;
    rdfs:comment "Unidimensional Individual (dimensionless in space, existant over all time)" ;
