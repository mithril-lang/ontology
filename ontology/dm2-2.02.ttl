dm2:SecurityAttributesGroup a owl:Class ;
    rdfs:label "SecurityAttributesGroup" ;
    rdfs:comment "The group of Information Security Marking attributes in which the use of attributes 'classification' and 'ownerProducer' is required. This group is to be contrasted with group 'SecurityAttributesOptionGroup' in which use of those attributes is optional." ;
    rdfs:subClassOf dm2:Information .

