    rdfs:subClassOf dm2:InformationType .

dm2:EndBoundaryType a owl:ObjectProperty ;
    rdfs:label "EndBoundaryType" ;
    rdfs:comment "A temporal whole part couple that relates the temporal boundary to the whole taken over a Type." ;
    rdfs:subPropertyOf dm2:TemporalBoundaryType .

