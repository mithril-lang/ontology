dm2:overlap a owl:ObjectProperty ;
    rdfs:label "overlap" ;
    rdfs:comment "A couple of wholePart couples where the part in each couple is the same." ;
    rdfs:range dm2:Individual ;
    rdfs:subPropertyOf dm2:wholePart .

dm2:portPartOfPerformer a owl:ObjectProperty ;
    rdfs:label "portPartOfPerformer" ;
    rdfs:comment "A an association of the whole Performer to its Port that is visible and interfaces with other Performers" ;
