dm2:startBoundary a owl:ObjectProperty ;
    rdfs:label "startBoundary" ;
    rdfs:comment "The beginning of a temporalBoundary." ;
    rdfs:subPropertyOf dm2:temporalBoundary .

dm2:superSubType a owl:ObjectProperty ;
    rdfs:label "superSubType" ;
    rdfs:comment "An association in which one Type (the subtype) is a subset of the other Type (supertype)." .

