    rdfs:subClassOf dm2:GeoPoliticalExtentTypeType .

dm2:Data a owl:Class ;
    rdfs:label "Data" ;
    rdfs:comment "Representation of information in a formalized manner suitable for communication, interpretation, or processing by humans or by automatic means. Examples could be whole models, packages, entities, attributes, classes, domain values, enumeration values, records, tables, rows, columns, and fields." ;
    rdfs:subClassOf dm2:Information .

dm2:DataType a owl:Class ;
    rdfs:label "DataType" ;
    rdfs:comment "Powertype of Data" ;
    rdfs:subClassOf dm2:InformationType .

dm2:DomainInformation a owl:Class ;
    rdfs:label "DomainInformation" ;
